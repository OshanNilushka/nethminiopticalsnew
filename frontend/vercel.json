{
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nethmini-core-backend-api-gaemekasc5f6hscv.centralindia-01.azurewebsites.net/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://nethmini-core-backend-api-gaemekasc5f6hscv.centralindia-01.azurewebsites.net/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

